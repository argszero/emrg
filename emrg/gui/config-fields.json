      "key": "model",
      "ipc": "model",
      "control": "custom",
      "widget": "default-model",
      "default": "gpt-4o-mini",
      "tab": "model"
    },
    {
      "section": "llm",
      "field": "models",
      "key": "models",
      "ipc": "models",
      "control": "custom",
