    {
      "section": "llm",
      "field": "api_key",
      "key": "api_key",
      "ipc": "apiKey",
      "control": "custom",
      "widget": "api-key",
      "default": "",
      "tab": "model"
    },
    {
      "section": "llm",
      "field": "base_url",
      "key": "base_url",
      "ipc": "baseUrl",
      "control": "custom",
      "widget": "text",
      "default": "https://api.openai.com/v1",
      "tab": "model"
    },
    {
