{
  "name": "emrg-gui",
  "version": "0.2.60",
  "description": "EMRG GUI — Electron client for the EMRG self-evolving AI agent (Phase 3)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:integration": "node --test test/integration.test.js",
    "vendor": "node scripts/build-vendor.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "highlight.js": "^11.10.0",
    "marked": "^12.0.2",
    "smol-toml": "^1.3.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "monaco-editor": "^0.56.0"
  },
  "build": {
    "appId": "com.emrg.gui",
    "productName": "EMRG",
    "extraResources": [
      {
        "from": "../dist/runtime",
        "to": "runtime"
      },
      {
        "from": "../packaging/assets/icon.png",
        "to": "icon.png"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "vendor/**",
      "conn-manager.js",
      "gui-state.js",
      "daemon_client.js",
      "package.json",
      "scripts/**"
    ],
    "icon": "icon.png",
    "mac": {
      "hardenedRuntime": true,
      "notarize": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "extraResources": [
        {
          "from": "../dist/runtime",
          "to": "runtime"
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "directories": {
      "buildResources": "../packaging/assets"
    }
  }
}
