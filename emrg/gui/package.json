{
  "name": "emrg-gui",
  "version": "0.1.0",
  "description": "EMRG GUI — Electron client for the EMRG self-evolving AI agent (Phase 3)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "test:integration": "node --test test/integration.test.js",
    "vendor": "node scripts/build-vendor.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "dompurify": "^3.1.6",
    "highlight.js": "^11.10.0",
    "marked": "^12.0.2",
    "smol-toml": "^1.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.emrg.gui",
    "productName": "EMRG",
    "extraResources": [
      {
        "from": "../dist/emrgd",
        "to": "emrgd"
      }
    ],
    "target": [
      "dmg",
      "exe",
      "AppImage"
    ],
    "icon": "../packaging/assets/",
    "mac": {
      "identity": null
    }
  }
}
